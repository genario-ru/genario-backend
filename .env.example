NODE_ENV=

POSTGRES_URL=
REDIS_URL=

# Connection string for postgres-exporter. Do not derive it from POSTGRES_URL.
# If the URL has no query string, add ?sslmode=disable.
# If it already has ?, add &sslmode=disable.
POSTGRES_EXPORTER_DATA_SOURCE_NAME=

# The private bucket shared by all projects.
S3_PRIVATE_BUCKET_BASE_URL=
S3_PRIVATE_BUCKET_NAME=
S3_PRIVATE_REGION=
S3_PRIVATE_ACCESS_KEY=
S3_PRIVATE_SECRET_ACCESS_KEY=
# This environment's folder of the bucket: genario/dev, genario/stage, genario/prod.
S3_PRIVATE_KEY_PREFIX=

# The public bucket shared by all projects. Read by the seed only: it turns
# s3-public:// addresses in data/*.json into URLs of the project's folder
# (S3_PUBLIC_KEY_PREFIX, genario/prod: public files are published once).
S3_PUBLIC_BUCKET_BASE_URL=
S3_PUBLIC_BUCKET_NAME=
S3_PUBLIC_KEY_PREFIX=

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
BETTER_AUTH_FIXED_SIGN_IN_OTPS=

BETTER_AUTH_DISABLE_SIGN_UP=
DISABLE_PAYMENTS=

POLZA_AI_BASE_URL=
POLZA_AI_API_KEY=
POLZA_AI_STRUCTURED_OUTPUT_MODEL=
POLZA_AI_IMAGE_MODEL=

VSELLM_BASE_URL=
VSELLM_API_KEY=
VSELLM_STRUCTURED_OUTPUT_MODEL=
VSELLM_IMAGE_MODEL=

SOCIALKIT_OPENAPI_URL=
SOCIALKIT_BASE_API_URL=
SOCIALKIT_API_KEY=

YOOKASSA_OPENAPI_URL=
YOOKASSA_BASE_URL=
YOOKASSA_SECRET_KEY=
YOOKASSA_SHOP_ID=
YOOKASSA_IPS=185.71.76.0/27,185.71.77.0/27,77.75.153.0/25,77.75.156.11,77.75.156.35,77.75.154.128/25,2a02:5180::/32

SUBSCRIPTIONS_CHARGE_SCHEDULER_ENABLED=true
UPCOMING_CHARGES_NEWSLETTER_SCHEDULER_ENABLED=true
TERMINATE_EXPIRED_CREDITS_BATCHES_SCHEDULER_ENABLED=true

FRONTEND_BASE_URL=
BACKEND_BASE_URL=

SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# dokploy-network subnet (docker network inspect dokploy-network) from which
# the monitoring agent reads /metrics directly, bypassing Traefik. CIDR is allowed.
METRICS_ALLOWED_IPS=
LOCAL_DEVELOPMENT_IPS=
TRUSTED_PROXY_COUNT=

GLITCHTIP_DSN=
GLITCHTIP_RELEASE=
