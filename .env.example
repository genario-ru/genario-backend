NODE_ENV=

POSTGRES_URL=
REDIS_URL=

# Строка для postgres-exporter. Не собирается из POSTGRES_URL.
# Если в URL нет query string, добавь ?sslmode=disable.
# Если ? уже есть, добавь &sslmode=disable.
